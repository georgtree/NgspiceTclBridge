# Makefile.in --
#
#	This file is a Makefile for Sample TEA Extension.  If it has the name
#	"Makefile.in" then it is a template for a Makefile;  to generate the
#	actual Makefile, run "./configure", which is a configuration script
#	generated by the "autoconf" program (constructs like "@foo@" will get
#	replaced in the actual Makefile.
#
# Copyright (c) 1999 Scriptics Corporation.
# Copyright (c) 2002-2005 ActiveState Corporation.
#
# See the file "license.terms" for information on usage and redistribution
# of this file, and for a DISCLAIMER OF ALL WARRANTIES.

#========================================================================
# Makefile variables
#========================================================================
PKG_SOURCES = @PKG_SOURCES@
PKG_OBJECTS = @PKG_OBJECTS@
DOC_HTML_FILES = @DOC_HTML_FILES@
DIST_TEST_FILES = @DIST_TEST_FILES@ test/memory.c test/mockngspice.c test/rbc.test test/rbc-graph.test test/rbc-support.tcl test/rbc-graph-real.test

PKG_STUB_SOURCES = @PKG_STUB_SOURCES@
PKG_STUB_OBJECTS = @PKG_STUB_OBJECTS@

PKG_TCL_SOURCES = @PKG_TCL_SOURCES@

PKG_HEADERS = @PKG_HEADERS@

PKG_LIB_FILE = @PKG_LIB_FILE@
PKG_LIB_FILE8 = @PKG_LIB_FILE8@
PKG_LIB_FILE9 = @PKG_LIB_FILE9@
PKG_STUB_LIB_FILE = @PKG_STUB_LIB_FILE@

lib_BINARIES = $(PKG_LIB_FILE)
BINARIES = $(lib_BINARIES)

SHELL = @SHELL@

srcdir = @srcdir@
prefix = @prefix@
exec_prefix = @exec_prefix@

bindir = @bindir@
libdir = @libdir@
includedir = @includedir@
datarootdir = @datarootdir@
runstatedir = @runstatedir@
datadir = @datadir@
mandir = @mandir@

DESTDIR =

PKG_DIR = $(PACKAGE_NAME)$(PACKAGE_VERSION)
pkgdatadir = $(datadir)/$(PKG_DIR)
pkglibdir = $(libdir)/$(PKG_DIR)
pkgincludedir = $(includedir)/$(PKG_DIR)

top_builddir = @abs_top_builddir@

INSTALL_OPTIONS	=
INSTALL = @INSTALL@ $(INSTALL_OPTIONS)
INSTALL_DATA_DIR = @INSTALL_DATA_DIR@
INSTALL_DATA = @INSTALL_DATA@
INSTALL_PROGRAM = @INSTALL_PROGRAM@
INSTALL_SCRIPT = @INSTALL_SCRIPT@
INSTALL_LIBRARY = @INSTALL_LIBRARY@
DOC_INSTALL_DIR = $(DESTDIR)$(pkgdatadir)/doc

PACKAGE_NAME = @PACKAGE_NAME@
PACKAGE_VERSION = @PACKAGE_VERSION@
CC = @CC@
CCLD = @CCLD@
CFLAGS_DEFAULT = @CFLAGS_DEFAULT@
CFLAGS_WARNING = @CFLAGS_WARNING@
EXEEXT = @EXEEXT@
MAKE_LIB = @MAKE_LIB@
MAKE_STUB_LIB = @MAKE_STUB_LIB@
OBJEXT = @OBJEXT@
RANLIB = @RANLIB@
RANLIB_STUB = @RANLIB_STUB@
SHLIB_CFLAGS = @SHLIB_CFLAGS@
SHLIB_LD = @SHLIB_LD@
SHLIB_LD_LIBS = @SHLIB_LD_LIBS@
STLIB_LD = @STLIB_LD@
TCL_BIN_DIR = @TCL_BIN_DIR@
TCL_SRC_DIR = @TCL_SRC_DIR@

EXTRA_PATH = $(top_builddir):$(TCL_BIN_DIR)
TCLLIBPATH = @TCLLIBPATH@
TCLSH_ENV = TCL_LIBRARY=`@CYGPATH@ $(TCL_SRC_DIR)/library`
PKG_ENV = @LD_LIBRARY_PATH_VAR@="$(EXTRA_PATH):$(@LD_LIBRARY_PATH_VAR@)" \
		  PATH="$(EXTRA_PATH):$(PATH)" \
		  TCLLIBPATH="$(TCLLIBPATH)"

TCLSH_PROG = @TCLSH_PROG@
TCLSH = $(TCLSH_ENV) $(PKG_ENV) $(TCLSH_PROG)

SHARED_BUILD = @SHARED_BUILD@

INCLUDES = @PKG_INCLUDES@ @TCL_INCLUDES@ -I.

PKG_CFLAGS = @PKG_CFLAGS@

DEFS = @DEFS@ $(PKG_CFLAGS)

CONFIG_CLEAN_FILES = Makefile pkgIndex.tcl
CLEANFILES = @CLEANFILES@

CPPFLAGS = @CPPFLAGS@
LIBS = @PKG_LIBS@ @LIBS@
AR = @AR@
CFLAGS = @CFLAGS@
LDFLAGS = @LDFLAGS@
LDFLAGS_DEFAULT	 = @LDFLAGS_DEFAULT@
COMPILE = $(CC) $(DEFS) $(INCLUDES) $(AM_CPPFLAGS) $(CPPFLAGS) $(AM_CFLAGS) \
			  $(CFLAGS)

GDB = gdb
VALGRIND = valgrind
VALGRINDARGS = --tool=memcheck --num-callers=8 --leak-resolution=high \
		  --leak-check=yes --show-reachable=yes -v

.SUFFIXES: .c .$(OBJEXT)

#========================================================================
# Top recipes
#========================================================================
all: binaries libraries

binaries: $(BINARIES)

libraries:

shell: binaries libraries
	@$(TCLSH) $(SCRIPT)

#========================================================================
# Test recipes
#========================================================================
test: binaries libraries test-memory
	$(TCLSH) `@CYGPATH@ $(srcdir)/test/all.tcl` $(TESTFLAGS) \
	    -load "package ifneeded $(PACKAGE_NAME) $(PACKAGE_VERSION) \
		[list load `@CYGPATH@ $(PKG_LIB_FILE)` [string totitle $(PACKAGE_NAME)]]"

# Standalone ownership regression: no ngspice library, argparse or extexpr required.
MEMORY_TEST = bridge-memory-test$(EXEEXT)
$(MEMORY_TEST): $(srcdir)/test/memory.c $(srcdir)/generic/ngspicetclbridgeRbc.c $(srcdir)/generic/ngspicetclbridge.c \
        $(srcdir)/generic/ngspicetclbridge.h $(srcdir)/generic/sharedspice.h $(srcdir)/generic/portable_dl.h
	$(COMPILE) -UUSE_TCL_STUBS $(LDFLAGS) -o $@ $(srcdir)/test/memory.c $(srcdir)/generic/ngspicetclbridgeRbc.c @TCL_LIB_SPEC@ @TCL_LIBS@ $(LIBS)

test-memory: $(MEMORY_TEST)
	$(PKG_ENV) ./$(MEMORY_TEST)

#========================================================================
# Optional integration checks use a deterministic shared-library fixture.
MOCK_NGSPICE = mock$(PKG_LIB_FILE)
$(MOCK_NGSPICE): $(srcdir)/test/mockngspice.c $(srcdir)/generic/sharedspice.h
	$(SHLIB_LD) $(CPPFLAGS) $(DEFS) $(INCLUDES) -UUSE_TCL_STUBS $(LDFLAGS) -o $@ $(srcdir)/test/mockngspice.c @TCL_LIB_SPEC@ @TCL_LIBS@ $(LIBS)

test-rbc: binaries $(MOCK_NGSPICE)
	$(PKG_ENV) $(TCLSH) $(srcdir)/test/rbc.test --rbc-fixture $(PKG_LIB_FILE) $(MOCK_NGSPICE)

test-rbc-graph: binaries $(MOCK_NGSPICE)
	$(PKG_ENV) $(TCLSH) $(srcdir)/test/rbc-graph.test --rbc-fixture $(PKG_LIB_FILE) $(MOCK_NGSPICE)

# Real-ngspice graph integration: supply the full shared-library filename.
NGSPICE_LIBRARY ?=
NGSPICE_TEST_TIMEOUT_MS ?= 180000
.PHONY: test-rbc test-rbc-graph test-rbc-graph-real

test-rbc-graph-real: binaries
	$(PKG_ENV) $(TCLSH) "$(srcdir)/test/rbc-graph-real.test" --real-ngspice "$(PKG_LIB_FILE)" "$(NGSPICE_LIBRARY)" "$(NGSPICE_TEST_TIMEOUT_MS)"

# Package installing recipes
#========================================================================
install: all install-binaries install-libraries install-doc

install-binaries: binaries install-lib-binaries install-bin-binaries

install-libraries: libraries
	@$(INSTALL_DATA_DIR) "$(DESTDIR)$(includedir)"
	@echo "Installing header files in $(DESTDIR)$(includedir)"
	@set -e; list='$(PKG_HEADERS)'; for i in $$list; do \
	    echo "Installing $(srcdir)/$$i"; \
	    $(INSTALL_DATA) "$(srcdir)/$$i" "$(DESTDIR)$(includedir)"; \
	done
	@set -e; list='$(PKG_STUB_SOURCES)'; for i in $$list; do \
	    echo "Installing $(srcdir)/$$i"; \
	    $(INSTALL_DATA) "$(srcdir)/$$i" "$(DESTDIR)$(includedir)"; \
	done

install-doc:
	@$(INSTALL_DATA_DIR) "$(DESTDIR)$(mandir)/mann"
	@echo "Installing documentation in $(DESTDIR)$(mandir)"
	@set -e; for i in "$(srcdir)"/docs/*.n; do \
	    test -f "$$i" || continue; \
	    echo "Installing $$i"; \
	    $(INSTALL_DATA) "$$i" "$(DESTDIR)$(mandir)/mann"; \
	done
	@$(INSTALL_DATA_DIR) "$(DOC_INSTALL_DIR)"
	@echo "Installing html documentation in $(DOC_INSTALL_DIR)"
	@set -e; list='$(DOC_HTML_FILES)'; for p in $$list; do \
	  if test -f "$(srcdir)/docs/$$p"; then \
	    d=`dirname "$$p"`; \
	    if test "x$$d" != "x."; then \
	      $(INSTALL_DATA_DIR) "$(DOC_INSTALL_DIR)/$$d"; \
	    fi; \
	    echo " Install $(srcdir)/docs/$$p $(DOC_INSTALL_DIR)/$$p"; \
	    $(INSTALL_DATA) "$(srcdir)/docs/$$p" "$(DOC_INSTALL_DIR)/$$p"; \
	  fi; \
	done
	@set -e; for directory in images _images; do \
	  if test -d "$(srcdir)/docs/$$directory"; then \
	    (cd "$(srcdir)/docs" && find "$$directory" -type f -print) | \
	    while IFS= read -r file; do \
	      $(INSTALL_DATA_DIR) "$(DOC_INSTALL_DIR)/`dirname "$$file"`"; \
	      $(INSTALL_DATA) "$(srcdir)/docs/$$file" "$(DOC_INSTALL_DIR)/$$file"; \
	    done; \
	  fi; \
	done
	@$(INSTALL_DATA) "$(srcdir)/LICENSE" "$(DOC_INSTALL_DIR)/LICENSE"

#========================================================================
# Debugging recipes
#========================================================================
gdb:
	$(TCLSH_ENV) $(PKG_ENV) $(GDB) $(TCLSH_PROG) $(SCRIPT)

gdb-test: binaries libraries
	$(TCLSH_ENV) $(PKG_ENV) $(GDB) \
	    --args $(TCLSH_PROG) `@CYGPATH@ $(srcdir)/test/all.tcl` \
	    $(TESTFLAGS) -singleproc 1 \
	    -load "package ifneeded $(PACKAGE_NAME) $(PACKAGE_VERSION) \
		[list load `@CYGPATH@ $(PKG_LIB_FILE)` [string totitle $(PACKAGE_NAME)]]"

valgrind: binaries libraries
	$(TCLSH_ENV) $(PKG_ENV) $(VALGRIND) $(VALGRINDARGS) $(TCLSH_PROG) \
	    `@CYGPATH@ $(srcdir)/test/all.tcl` $(TESTFLAGS)

valgrindshell: binaries libraries
	$(TCLSH_ENV) $(PKG_ENV) $(VALGRIND) $(VALGRINDARGS) $(TCLSH_PROG) $(SCRIPT)

#========================================================================
# Doc generating recipes
#========================================================================
doc:
	$(TCLSH) $(srcdir)/docs/doc_gen.tcl

#========================================================================
# Building recipes
#========================================================================
depend:

$(PKG_LIB_FILE): $(PKG_OBJECTS)
	-rm -f $(PKG_LIB_FILE)
	${MAKE_LIB}
	$(RANLIB) $(PKG_LIB_FILE)

$(PKG_STUB_LIB_FILE): $(PKG_STUB_OBJECTS)
	-rm -f $(PKG_STUB_LIB_FILE)
	${MAKE_STUB_LIB}
	$(RANLIB_STUB) $(PKG_STUB_LIB_FILE)

VPATH = $(srcdir):$(srcdir)/generic:$(srcdir)/unix:$(srcdir)/win:$(srcdir)/macosx

.c.@OBJEXT@:
	$(COMPILE) -c `@CYGPATH@ $<` -o $@

#========================================================================
# Installation distribution (merge the archive contents into the install prefix).
# Uses the install targets so runtime resources, headers, demos and docs agree.
#========================================================================
DIST_ROOT = $(top_builddir)/dist
DIST_NAME = $(PKG_DIR)
DIST_DIR = $(DIST_ROOT)/$(DIST_NAME)

dist-clean:
	rm -rf "$(DIST_DIR)"
	rm -f "$(DIST_ROOT)/$(DIST_NAME).tar.gz" "$(DIST_ROOT)/$(DIST_NAME).zip"

# Do not make dist-clean a parallel prerequisite: staging must finish before
# archiving, and cleanup must not race with the installer.
dist: all
	@set -eu; \
	  case '$(DIST_NAME)' in ''|.|..|*/*|*\\*) echo 'dist: DIST_NAME must be a directory name' >&2; exit 1 ;; esac; \
	  root=`mkdir -p "$(DIST_ROOT)" && cd "$(DIST_ROOT)" && pwd`; \
	  stage="$$root/$(DIST_NAME)"; \
	  prefix='$(prefix)'; prefix=$${prefix%/}; \
	  relative() { \
	    case "$$1" in \
	      "$$prefix"/*) printf '%s\n' "$${1#"$$prefix"}" ;; \
	      *) echo "dist: install directory '$$1' is outside prefix '$$prefix'" >&2; return 1 ;; \
	    esac; \
	  }; \
	  set --; \
	  for entry in 'bindir=$(bindir)' 'libdir=$(libdir)' 'includedir=$(includedir)' \
	      'datadir=$(datadir)' 'mandir=$(mandir)' 'pkglibdir=$(pkglibdir)' \
	      'pkgdatadir=$(pkgdatadir)' 'pkgincludedir=$(pkgincludedir)'; do \
	    key=$${entry%%=*}; value=$${entry#*=}; \
	    value=`relative "$$value"`; \
	    set -- "$$@" "$$key=$$stage$$value"; \
	  done; \
	  doc='$(DOC_INSTALL_DIR)'; dest='$(DESTDIR)'; doc=$${doc#"$$dest"}; \
	  doc=`relative "$$doc"`; \
	  rm -rf "$$stage"; mkdir -p "$$stage"; \
	  rm -f "$$root/$(DIST_NAME).tar.gz" "$$root/$(DIST_NAME).zip"; \
	  $(MAKE) install DESTDIR= "$$@" "DOC_INSTALL_DIR=$$stage$$doc"; \
	  tar -czf "$$root/$(DIST_NAME).tar.gz" -C "$$stage" .; \
	  echo "Installation archive: $$root/$(DIST_NAME).tar.gz"

# ZIP is convenient for Windows Explorer. The payload is identical to dist.
dist-zip: dist
	cd "$(DIST_DIR)" && zip -qr "$(abspath $(DIST_ROOT))/$(DIST_NAME).zip" .

#========================================================================
# Cleaning of building files
#========================================================================
clean:
	-rm -f $(MEMORY_TEST) $(MOCK_NGSPICE)
	-test -z "$(BINARIES)" || rm -f $(BINARIES)
	-rm -f *.$(OBJEXT) core *.core
	-test -z "$(CLEANFILES)" || rm -f $(CLEANFILES)
	-rm -rf docs/sphinx
	-rm -rf docs/.doctrees
	-rm -rf docs/_sources
	-rm -f docs/.buildinfo

distclean: clean
	-rm -f *.tab.c
	-rm -f $(CONFIG_CLEAN_FILES)
	-rm -f config.cache config.log config.status

#========================================================================
# Install binary object libraries.
#========================================================================
install-lib-binaries: binaries
	@$(INSTALL_DATA_DIR) "$(DESTDIR)$(pkglibdir)"
	@set -e; list='$(lib_BINARIES)'; for p in $$list; do \
	  if test -f "$$p"; then \
	    echo " $(INSTALL_LIBRARY) $$p $(DESTDIR)$(pkglibdir)/$$p"; \
	    $(INSTALL_LIBRARY) "$$p" "$(DESTDIR)$(pkglibdir)/$$p"; \
	    ext=`echo "$$p" | sed -e "s/.*\.//"`; \
	    if test "x$$ext" = "xdll"; then \
		lib=`basename "$$p" | sed -e 's/.[^.]*$$//'`.lib; \
		if test -f "$$lib"; then \
		    echo " $(INSTALL_DATA) $$lib $(DESTDIR)$(pkglibdir)/$$lib"; \
		    $(INSTALL_DATA) "$$lib" "$(DESTDIR)$(pkglibdir)/$$lib"; \
		fi; \
	    fi; \
	  fi; \
	done
	@set -e; list='$(PKG_TCL_SOURCES)'; for p in $$list; do \
	  if test -f "$(srcdir)/$$p"; then \
	    destp=`basename "$$p"`; \
	    echo " Install $$destp $(DESTDIR)$(pkglibdir)/$$destp"; \
	    $(INSTALL_DATA) "$(srcdir)/$$p" "$(DESTDIR)$(pkglibdir)/$$destp"; \
	  fi; \
	done
	@if test "x$(SHARED_BUILD)" = "x1"; then \
	    echo " Install pkgIndex.tcl $(DESTDIR)$(pkglibdir)"; \
	    $(INSTALL_DATA) pkgIndex.tcl "$(DESTDIR)$(pkglibdir)"; \
	fi

install-bin-binaries: binaries
	@$(INSTALL_DATA_DIR) "$(DESTDIR)$(bindir)"
	@set -e; list='$(bin_BINARIES)'; for p in $$list; do \
	  if test -f "$$p"; then \
	    echo " $(INSTALL_PROGRAM) $$p $(DESTDIR)$(bindir)/$$p"; \
	    $(INSTALL_PROGRAM) "$$p" "$(DESTDIR)$(bindir)/$$p"; \
	  fi; \
	done

Makefile: $(srcdir)/Makefile.in  $(top_builddir)/config.status
	cd $(top_builddir) \
	  && CONFIG_FILES=$@ CONFIG_HEADERS= $(SHELL) ./config.status

#========================================================================
# Uninstall recipes
#========================================================================
# Remove the package-owned directory and only named files from shared paths.
uninstall-binaries:
	rm -rf "$(DESTDIR)$(pkglibdir)"
	@set -e; list='$(bin_BINARIES)'; for p in $$list; do \
	  rm -f "$(DESTDIR)$(bindir)/$$p"; \
	done

uninstall-libraries:
	@set -e; list='$(PKG_HEADERS) $(PKG_STUB_SOURCES)'; for p in $$list; do \
	  name=`basename "$$p"`; \
	  rm -f "$(DESTDIR)$(includedir)/$$name"; \
	done

uninstall-doc:
	@set -e; for p in "$(srcdir)"/docs/*.n; do \
	  test -f "$$p" || continue; \
	  name=`basename "$$p"`; \
	  rm -f "$(DESTDIR)$(mandir)/mann/$$name"; \
	done
	@set -e; list='$(DOC_HTML_FILES) LICENSE'; for p in $$list; do \
	  rm -f "$(DOC_INSTALL_DIR)/$$p"; \
	done
	@set -e; for directory in images _images; do \
	  if test -d "$(srcdir)/docs/$$directory"; then \
	    (cd "$(srcdir)/docs" && find "$$directory" -type f -print) | \
	    while IFS= read -r file; do \
	      rm -f "$(DOC_INSTALL_DIR)/$$file"; \
	    done; \
	  fi; \
	done
	@# Remove empty documentation directories, leaving unrelated files intact.
	@if test -d "$(DOC_INSTALL_DIR)"; then \
	  find "$(DOC_INSTALL_DIR)" -depth -type d -exec rmdir {} \; 2>/dev/null || :; \
	fi

uninstall: uninstall-binaries uninstall-libraries uninstall-doc

#========================================================================
# Flag PHONY recipes
#========================================================================
.PHONY: all binaries clean depend dist dist-clean dist-zip distclean doc install libraries test test-memory
.PHONY: gdb gdb-test valgrind valgrindshell

.PHONY: install-binaries install-lib-binaries install-bin-binaries install-libraries install-doc \
	uninstall uninstall-binaries uninstall-libraries uninstall-doc

.NOEXPORT:
