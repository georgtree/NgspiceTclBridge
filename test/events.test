# Headless deterministic raw-event tests, explicitly invoked by make test-events.
if {[lindex $argv 0] ne {--rbc-fixture}} {
    return
}
package require tcltest
namespace import ::tcltest::*
source [file join [file dirname [info script]] rbc-support.tcl]

proc eventSim {mode} {
    set s [newSim -noinit]
    $s circuit {fixture .end}
    $s eventnodes -all -mode $mode
    return $s
}
proc stopEvents {s} {
    catch {$s command mock_evt_stop}
    clean $s
}

test events-1 {discovery, internal names, one registration per node and invalid names} -body {
    set s [eventSim changes]
    set first [$s command mock_evt_registrations]
    $s eventnodes -all
    set info [$s eventnodes]
    set rc [catch {$s eventnodes -nodes {a missing}}]
    list $first [$s command mock_evt_registrations] [lsort [dict get $info selected]] $rc\
            [expr {[$s eventnodes] eq $info}]
} -cleanup {clean $s} -result {3 3 {a b x1:internal} 1 1}

test events-2 {changes wait for all-node boundary; last on A does not complete B} -body {
    set s [eventSim changes]
    $s command mock_evt_start
    $s command mock_evt_a
    set early [dict get [$s eventdata] batches]
    $s flush
    set flushed [dict get [$s eventdata] batches]
    $s command mock_evt_b
    set stillEarly [dict get [$s eventdata] batches]
    $s command mock_evt_boundary
    set data [$s eventdata]
    list $early $flushed $stillEarly [dict get [lindex [dict get $data batches] 0] events]
} -cleanup {stopEvents $s} -result {{} {} {} {{a 0.0 0s 0} {a 0.0 1s 1} {b 0.0 Uz 1}}}

test events-3 {snapshots carry unchanged states and identify missing values} -body {
    set s [eventSim snapshot]
    $s command mock_evt_start
    $s command mock_evt_a
    $s command mock_evt_b
    $s command mock_evt_boundary
    $s command mock_evt_boundary
    set batches [dict get [$s eventdata] batches]
    set a [lindex $batches 0]
    set b [lindex $batches 1]
    list [dict get $a values a] [dict get $a values b] [dict get $a values x1:internal] [lsort [dict get $a known]]\
            [expr {[dict get $a values] eq [dict get $b values]}]
} -cleanup {stopEvents $s} -result {1s Uz {} {a b} 1}

test events-4 {pernode is visible before the next sample; strings are owned copies} -body {
    set s [eventSim pernode]
    $s command mock_evt_start
    $s command mock_evt_a
    set old [$s eventdata]
    $s command mock_evt_b
    list [dict get $old nodes a events] [dict get $old nodes b events] [dict get [$s eventdata] nodes b events]
} -cleanup {stopEvents $s} -result {{{0.0 0s 0} {0.0 1s 1}} {} {{0.0 Uz 1}}}

foreach mode {changes snapshot pernode} {
    test events-5.$mode {halt seals final batch, resume retains data, new plot resets, no duplicate registration}\
            -body {
        set s [eventSim $mode]
        $s command mock_evt_start
        $s command mock_evt_a
        $s command mock_evt_stop
        set before [$s eventdata]
        $s command mock_evt_resume
        $s command mock_evt_b
        $s command mock_evt_stop
        set resumed [$s eventdata]
        set base [dict get [$s eventcounts] event_init]
        $s command mock_evt_start
        set fresh [$s eventdata]
        list [lsort [dict keys $resumed]] [lsort [dict keys $fresh]]\
                [dict get [$s waitevent event_init -since $base 1] status] [dict get $fresh batches]\
                [$s command mock_evt_registrations] [expr {$before ne $resumed}]
    } -cleanup {stopEvents $s} -result {{analysis batches mode nodes} {analysis batches mode nodes} ok {} 3 1}
}

test events-6 {clear discards pending and committed records but later callbacks continue} -body {
    set s [eventSim changes]
    $s command mock_evt_start
    $s command mock_evt_a
    set empty [$s eventdata -clear]
    $s command mock_evt_b
    $s command mock_evt_stop
    list [dict get $empty batches] [dict get [lindex [dict get [$s eventdata] batches] 0] events]
} -cleanup {stopEvents $s} -result {{} {{b 0.0 Uz 1}}}

test events-7 {raw counters, batch counters and since semantics are independent} -body {
    set s [eventSim changes]
    $s eventcounts -clear
    $s command mock_evt_start
    set base [dict get [$s eventcounts] send_raw_evt]
    $s command mock_evt_a
    set early [$s eventcounts]
    set arrived [$s waitevent send_raw_evt -since $base -n 2 1]
    $s command mock_evt_stop
    set done [$s eventcounts]
    list [dict get $early send_raw_evt] [dict get $early event_batch] [dict get $arrived status]\
            [dict get $done event_batch] [dict get $done event_init]
} -cleanup {clean $s} -result {2 0 ok 1 1}

test events-8 {configuration and circuit replacement while running are rejected} -body {
    set s [eventSim changes]
    $s command mock_evt_start
    set busy [catch {$s eventnodes -mode pernode}]
    set replaceBusy [catch {$s circuit {replacement .end}}]
    $s command mock_evt_stop
    list $busy $replaceBusy [catch {$s command reset}] [catch {$s eventnodes -all -nodes a}]
} -cleanup {clean $s} -result {1 1 1 1}

test events-9 {selection limits histories; mode change clears and reuses registrations} -body {
    set s [eventSim changes]
    $s eventnodes -nodes a -mode pernode
    $s command mock_evt_start
    $s command mock_evt_a
    $s command mock_evt_b
    $s command mock_evt_stop
    set before [$s eventdata]
    $s eventnodes -nodes {a b} -mode snapshot
    set after [$s eventdata]
    list [dict keys [dict get $before nodes]] [llength [dict get $before nodes a events]]\
            [dict get $after mode] [dict get $after batches] [$s command mock_evt_registrations]
} -cleanup {clean $s} -result {a 2 snapshot {} 3}

test events-10 {snapshot clear retains known states without publishing the cleared partial batch} -body {
    set s [eventSim snapshot]
    $s command mock_evt_start
    $s command mock_evt_a
    $s eventdata -clear
    $s command mock_evt_boundary
    set before [$s eventdata]
    $s command mock_evt_stop
    set after [$s eventdata]
    list [dict get $before batches] [dict get [lindex [dict get $after batches] 0] values a]
} -cleanup {clean $s} -result {{} 1s}

test events-11 {query after controlled exit is rejected without touching the destroyed native circuit} -body {
    set s [eventSim changes]
    $s command quit
    catch {$s eventnodes} message
    set message
} -cleanup {clean $s} -result {event node discovery/configuration requires an idle simulator}

test events-replace-1 {replacement clears records and renews all registrations, preserving mode} -body {
    set s [eventSim pernode]
    $s command mock_evt_start
    $s command mock_evt_a
    $s command mock_evt_stop
    set saved [$s eventdata]
    $s circuit -string "replacement\n.end"
    set empty [$s eventdata]
    $s command mock_evt_start
    $s command mock_evt_a
    $s command mock_evt_stop
    list [dict get $empty mode] [dict get $empty nodes a events] [$s command mock_evt_registrations]\
            [expr {[dict get [$s eventdata] nodes a events] eq [dict get $saved nodes a events]}]
} -cleanup {clean $s} -result {pernode {} 6 1}

test events-replace-2 {explicit selection clears; mode remains; later selection registers only once} -body {
    set s [eventSim snapshot]
    $s eventnodes -nodes a
    $s circuit {replacement .end}
    set info [$s eventnodes]
    $s eventnodes -nodes b
    $s eventnodes -nodes b
    list [dict get $info mode] [dict get $info selected] [$s command mock_evt_registrations]
} -cleanup {clean $s} -result {snapshot {} 4}

test events-replace-3 {failed replacement leaves empty event data and allows retry with retained all policy} -body {
    set s [eventSim changes]
    $s command mock_evt_start
    $s command mock_evt_a
    $s command mock_evt_stop
    set rc [$s circuit -string "mock_bad_deck\nr1 1 0 1k\nv1 1 0 1\n.end"]
    set empty [$s eventdata]
    $s circuit -string "good\nr1 1 0 1k\nv1 1 0 1\n.end"
    list $rc [dict get $empty nodes] [dict get $empty batches] [llength [dict get [$s eventnodes] selected]]\
            [$s command mock_evt_registrations]
} -cleanup {clean $s} -result {1 {} {} 3 6}

foreach mode {changes snapshot pernode} {
    test events-static-$mode {OP/DC coordinates, complete points, owned strings and mode-specific suppression} -body {
        set s [eventSim $mode]
        $s command op
        set op [$s eventdata]
        $s command {dc vin 0 2 1 vbias 10 20 10}
        set dc [$s eventdata]
        set counts [$s eventcounts]
        if {$mode eq {pernode}} {
            set records [dict get $dc nodes a events]
            set last [lindex $records end]
            set detail [list [llength $records] [dict get $last point] [dict get $last coordinates]]
        } else {
            set records [dict get $dc batches]
            set last [lindex $records end]
            set detail [list [llength $records] [dict get $last point] [dict get $last coordinates]]
        }
        list [dict get $op analysis] [dict get $dc analysis] $detail [dict get $counts send_raw_evt] \
            [dict get $counts event_batch] [lsort [dict keys [dict get $dc nodes]]]
    } -cleanup {clean $s} -result [list op dc [expr {$mode eq {snapshot} ? {6 5 {vin 2.0 vbias 20.0}} :\
                                                             {4 4 {vin 1.0 vbias 20.0}}}] 0 7 {a b x1:internal}]
}

test events-static-errors {unsupported analysis and query failure are sticky; a new transient clears the error} -body {
    set s [eventSim snapshot]
    $s command mock_ac
    set ac [catch {$s eventdata}]
    $s command mock_static_missing
    $s command op
    set missing [catch {$s eventdata}]
    set cleared [catch {$s eventdata -clear}]
    $s command mock_evt_start
    $s command mock_evt_a
    $s command mock_evt_stop
    list $ac $missing $cleared [dict get [$s eventdata] analysis]
} -cleanup {clean $s} -result {1 1 1 tran}

test events-static-coordinate-error {nested expressions do not silently produce wrong outer coordinates} -body {
    set s [eventSim snapshot]
    $s command {dc vin 0 {limit} 1 vbias 0 1 1}
    catch {$s eventdata} message
    set message
} -cleanup {clean $s} -result {nested DC event coordinates require literal numeric sweep limits and nonzero steps}

finishTests
