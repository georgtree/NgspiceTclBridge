# Run explicitly; the ordinary tcltest directory runner must not load this optional suite.
if {[lindex $argv 0] ne "--rbc-fixture"} {
    return
}

package require tcltest
namespace import ::tcltest::*

# Optional, headless integration: make test-rbc (TCLLIBPATH must locate rbc::vector).
source [file join [file dirname [info script]] rbc-support.tcl]

test rbc-1.1 {list interface and independent list snapshots remain unchanged} -body {
    set s [newSim]
    begin $s
    list [dict get [$s vectors] v(out)] [$s asyncvector v(1)]
} -cleanup {clean $s} -result {{0.0 2.0 4.0} {{0.0 0.0} {2.0 -3.0} {4.0 -6.0}}}

test rbc-1.2 {literal names, real and complex live output} -constraints rbc -body {
    set s [newSim -output vector]
    begin $s
    set names [$s vectors]
    list [dict get $names v(out)] [dict get $names v(1)] [::live::v(out) range 0 end] [::live::v(1) range 0 end]
} -cleanup {clean $s} -result {::live::v(out) ::live::v(1) {0.0 2.0 4.0} {{0.0 0.0} {2.0 -3.0} {4.0 -6.0}}}

test rbc-1.3 {clear discards queued samples and retains vector names} -constraints rbc -body {
    set s [newSim -output vector]
    begin $s
    set names [$s vectors]
    $s command mock_point
    $s vectors -clear
    update
    set empty [::live::v(out) length]
    $s command mock_point
    update
    list $empty [expr {$names eq [$s vectors]}] [::live::v(out) range 0 end]
} -cleanup {clean $s} -result {0 1 8.0}

test rbc-1.4 {new run reuses commands despite default collision error} -constraints rbc -body {
    set s [newSim -output vector]
    begin $s
    set names [$s vectors]
    begin $s 2
    list [expr {$names eq [$s vectors]}] [::live::v(out) range 0 end]
} -cleanup {clean $s} -result {1 {0.0 2.0}}

test rbc-1.5 {snapshot override and caller ownership} -constraints rbc -body {
    set s [newSim -output vector]
    begin $s
    set snapshot [$s asyncvector v(out) -name ::snap::copy]
    set plain [$s asyncvector v(out) -output list]
    $s destroy
    list $snapshot [$snapshot range 0 end] $plain [info commands ::live::v(out)]
} -cleanup {clean $s} -result {::snap::copy {0.0 2.0 4.0} {0.0 2.0 4.0} {}}

test rbc-1.6 {list handle can request complex vector snapshot} -constraints rbc -body {
    set s [newSim]
    begin $s
    set v [$s asyncvector v(1) -output vector -name ::snap::v(1)]
    list $v [$v range 0 end]
} -cleanup {clean $s} -result {::snap::v(1) {{0.0 0.0} {2.0 -3.0} {4.0 -6.0}}}

test rbc-1.7 {replace adopts existing vector; handle does not destroy it} -constraints rbc -body {
    rbc::vector create ::live::v(out) -literal true -variable {}
    ::live::v(out) set {99}
    set s [newSim -output vector -ifexists replace]
    begin $s
    $s destroy
    list [::live::v(out) range 0 end] [info commands ::live::time]
} -cleanup {clean $s} -result {{0.0 2.0 4.0} {}}

test rbc-1.8 {snapshot refuses a live destination even with replace} -constraints rbc -body {
    set s [newSim -output vector]
    begin $s
    catch {$s asyncvector v(out) -name ::live::v(out) -ifexists replace} message
    list $message [::live::v(out) length]
} -cleanup {clean $s} -result {{vector "::live::v(out)" is maintained by a simulator handle} 3}

test rbc-1.9 {snapshot collision policy and replace} -constraints rbc -body {
    set s [newSim]
    begin $s
    $s asyncvector v(out) -output vector -name ::snap::copy
    set collision [catch {$s asyncvector v(out) -output vector -name ::snap::copy}]
    $s command mock_point
    $s asyncvector v(out) -output vector -name ::snap::copy -ifexists replace
    list $collision [::snap::copy length]
} -cleanup {clean $s} -result {1 4}

test rbc-1.10 {worker callbacks update live vectors during simulation} -constraints rbc -body {
    set s [newSim -output vector]
    $s command bg_run
    waitUntil {[dict exists [$s vectors] v(out)] && [::live::v(out) length] >= 3}
    set active [$s isrunning]
    waitUntil {![$s isrunning]}
    list $active [::live::v(out) length] [::live::v(out) index end]
} -cleanup {clean $s} -result {1 100 198.0}

test rbc-1.11 {invalid options fail before loading the shared library} -body {
    catch {::ngspicetclbridge::new nonexistent -output bad} message
    set message
} -result {-output must be list or vector}


proc bgerror {message} {
    lappend ::outputErrors $message
}

test rbc-2.1 {collision is persistent and reported once; no partial creation} -constraints rbc -body {
    set ::outputErrors {}
    proc ::live::v(out) {} {}
    set s [newSim -output vector]
    begin $s
    set failed [catch {$s vectors} message]
    for {set i 0} {$i < 5} {incr i} {
        $s command mock_point
        update
    }
    list $failed [llength $::outputErrors] [info commands ::live::time] $message
} -cleanup {clean $s} -result {1 1 {} {command "::live::v(out)" already exists and is not an RBC vector}}

test rbc-2.2 {deleted live vector is not silently recreated} -constraints rbc -body {
    set ::outputErrors {}
    set s [newSim -output vector]
    begin $s
    rename ::live::v(out) {}
    $s command mock_point
    update
    set failed [catch {$s vectors} message]
    list $failed [llength $::outputErrors] [info commands ::live::v(out)] $message
} -cleanup {clean $s} -result {1 1 {} {live vector "::live::v(out)" was deleted or renamed}}

test rbc-2.3 {borrowed renamed vector survives handle destruction} -constraints rbc -body {
    rbc::vector create ::live::v(out) -literal true -variable {}
    set s [newSim -output vector -ifexists replace]
    begin $s
    rename ::live::v(out) ::live::renamed
    set failed [catch {$s vectors}]
    $s destroy
    list $failed [::live::renamed length]
} -cleanup {clean $s} -result {1 3}

test rbc-2.4 {wrong numeric type cannot be replaced} -constraints rbc -body {
    set s [newSim]
    begin $s
    rbc::vector create ::snap::copy -type complex -variable {}
    catch {$s asyncvector v(out) -output vector -name ::snap::copy -ifexists replace} message
    set message
} -cleanup {clean $s} -result {vector "::snap::copy" has a different numeric type}

test rbc-2.5 {missing info query releases realloc lock} -body {
    set s [newSim]
    begin $s
    set failed [catch {$s asyncvector -info missing}]
    list $failed [$s asyncvector v(out)]
} -cleanup {clean $s} -result {1 {0.0 2.0 4.0}}

test rbc-2.6 {repeated asynchronous runs retain identities and replace samples} -constraints rbc -body {
    set s [newSim -output vector]
    $s command bg_run
    waitUntil {[dict exists [$s vectors] v(out)] && [::live::v(out) length] > 0}
    waitUntil {![$s isrunning]}
    set names [$s vectors]
    $s command bg_run
    waitUntil {[$s isrunning]}
    waitUntil {![$s isrunning]}
    list [expr {$names eq [$s vectors]}] [::live::v(out) length]
} -cleanup {clean $s} -result {1 100}

test rbc-3.1 {multiple growing batches retain previous real and complex samples} -constraints rbc -body {
    set s [newSim -output vector]
    begin $s 200
    set snapshot [$s asyncvector v(out) -name ::snap::old]
    for {set i 0} {$i < 900} {incr i} {
        $s command mock_point
        if {$i % 100 == 0} {
            update
        }
    }
    update
    list [::live::v(out) length] [::live::v(out) index 199] [::live::v(out) index end] [::live::v(1) index end]\
            [$snapshot length]
} -cleanup {clean $s} -result {1100 398.0 2198.0 {{2198.0 -3297.0}} 200}

test rbc-rename-1 {live real and complex vectors follow full RBC renames across clear and rerun} -constraints rbc -body {
    set s [newSim -output vector]
    begin $s
    rbc::vector rename ::live::v(out) ::snap::renamed
    rbc::vector rename ::live::v(1) ::snap::complex(1)
    set names [$s vectors]
    $s command mock_point
    update
    set data [list [::snap::renamed range 0 end] [::snap::complex(1) range 0 end]]
    $s vectors -clear
    set empty [list [::snap::renamed length] [::snap::complex(1) length]]
    begin $s 2
    list [dict get $names v(out)] [dict get $names v(1)] $data $empty \
        [expr {$names eq [$s vectors]}] [::snap::renamed range 0 end] [info commands ::live::v(out)]
} -cleanup {clean $s} -result {::snap::renamed ::snap::complex(1) {{0.0 2.0 4.0 6.0} {{0.0 0.0} {2.0 -3.0} {4.0 -6.0} {6.0 -9.0}}} {0 0} 1 {0.0 2.0} {}}

test rbc-rename-2 {renamed owned vectors are destroyed; renamed borrowed vectors survive} -constraints rbc -body {
    rbc::vector create ::live::v(out) -literal true -variable {}
    set s [newSim -output vector -ifexists replace]
    begin $s
    rbc::vector rename ::live::v(out) ::snap::borrowed
    rbc::vector rename ::live::v(1) ::snap::owned
    $s destroy
    list [::snap::borrowed range 0 end] [info commands ::snap::owned]
} -cleanup {clean $s} -result {{0.0 2.0 4.0} {}}

test rbc-rename-3 {renamed destination remains protected from snapshot replacement} -constraints rbc -body {
    set s [newSim -output vector]
    begin $s
    rbc::vector rename ::live::v(out) ::snap::renamed
    catch {$s asyncvector v(out) -name ::snap::renamed -ifexists replace} message
    list $message [::snap::renamed length]
} -cleanup {clean $s} -result {{vector "::snap::renamed" is maintained by a simulator handle} 3}

test rbc-rename-4 {deletion after rename invalidates binding even if the name is reused} -constraints rbc -body {
    set ::outputErrors {}
    set s [newSim -output vector]
    begin $s
    rbc::vector rename ::live::v(out) ::snap::renamed
    rbc::vector destroy ::snap::renamed
    rbc::vector create ::snap::renamed -variable {}
    ::snap::renamed set {99}
    $s command mock_point
    update
    list [catch {$s vectors}] [llength $::outputErrors] [::snap::renamed range 0 end]
} -cleanup {clean $s} -result {1 1 99.0}

test rbc-rename-5 {renaming while a worker is streaming retains incoming data} -constraints rbc -body {
    set ::outputErrors {}
    set s [newSim -output vector]
    $s command bg_run
    waitUntil {[dict exists [$s vectors] v(out)] && [::live::v(out) length] >= 3}
    rbc::vector rename ::live::v(out) ::snap::first
    rbc::vector rename ::snap::first ::snap::second
    waitUntil {![$s isrunning]}
    list [dict get [$s vectors] v(out)] [::snap::second length] \
        [::snap::second index end] [llength $::outputErrors]
} -cleanup {clean $s} -result {::snap::second 100 198.0 0}

test rbc-namespace-1 {create nested namespace even for list output; keep it after destroy} -body {
    set before [package provide rbc::vector]
    set s [::ngspicetclbridge::new $mockLibrary -namespace ::nsBridge::nested]
    set exists [namespace exists ::nsBridge::nested]
    $s destroy
    list $exists [namespace exists ::nsBridge::nested] [expr {$before eq [package provide rbc::vector]}]
} -cleanup {catch {$s destroy}; namespace delete ::nsBridge} -result {1 1 1}

test rbc-namespace-2 {snapshot default and relative name use configured namespace; absolute name overrides} -constraints rbc -body {
    set s [::ngspicetclbridge::new $mockLibrary -namespace ::nsBridge::nested]
    begin $s
    set a [$s asyncvector time -output vector]
    set b [$s asyncvector v(1) -output vector -name complexCopy]
    set c [$s asyncvector v(out) -output vector -name ::snap::absolute]
    set data [list [$a length] [$b type] [$c range 0 end]]
    $s destroy
    list $a $b $c $data [$a length]
} -cleanup {clean $s; namespace delete ::nsBridge} \
-result {::nsBridge::nested::time ::nsBridge::nested::complexCopy ::snap::absolute {3 complex {0.0 2.0 4.0}} 3}

test rbc-namespace-3 {explicit namespace is fixed relative to handle creation caller} -constraints rbc -body {
    namespace eval ::nsBridge {}
    set s [namespace eval ::nsBridge [list ::ngspicetclbridge::new $mockLibrary -namespace child]]
    begin $s
    namespace eval ::snap [list $s asyncvector time -output vector]
} -cleanup {clean $s; namespace delete ::nsBridge} -result ::nsBridge::child::time

test rbc-namespace-4 {omitted namespace preserves snapshot caller behavior} -constraints rbc -body {
    namespace eval ::nsBridge {}
    set s [namespace eval ::nsBridge [list ::ngspicetclbridge::new $mockLibrary]]
    begin $s
    namespace eval ::snap [list $s asyncvector time -output vector]
} -cleanup {clean $s; namespace delete ::nsBridge} -result ::snap::time

test rbc-namespace-5 {live and snapshot namespace agree; live collision stays protected} -constraints rbc -body {
    set s [::ngspicetclbridge::new $mockLibrary -output vector -namespace ::nsBridge]
    begin $s
    set collision [catch {$s asyncvector time -ifexists replace}]
    set copy [$s asyncvector time -name savedTime]
    list [dict get [$s vectors] time] $collision $copy [$copy length]
} -cleanup {clean $s; namespace delete ::nsBridge} -result {::nsBridge::time 1 ::nsBridge::savedTime 3}

test rbc-namespace-6 {snapshot collision policy unchanged in configured namespace} -constraints rbc -body {
    set s [::ngspicetclbridge::new $mockLibrary -namespace ::nsBridge]
    begin $s
    $s asyncvector time -output vector
    set collision [catch {$s asyncvector time -output vector}]
    set replaced [$s asyncvector time -output vector -ifexists replace]
    list $collision $replaced
} -cleanup {clean $s; namespace delete ::nsBridge} -result {1 ::nsBridge::time}

test rbc-namespace-7 {empty namespace is rejected} -body {
    ::ngspicetclbridge::new $mockLibrary -namespace {}
} -returnCodes error -result {-namespace must not be empty}

# Exercise the public Tcl helper as well as the C snapshot command.
source [file join [file dirname [info script]] .. ngspicetclbridge.tcl]

test rbc-readall-1 {list snapshots and metadata preserve their dictionary representations} -body {
    set s [newSim]
    begin $s
    set data [::ngspicetclbridge::readVecsAsync $s]
    set metadata [::ngspicetclbridge::readVecsAsync -info $s]
    list [dict get $data v(out)] [dict get $data v(1)] \
        [dict get $metadata v(1) ntype] [dict get $metadata time length]
} -cleanup {clean $s} -result {{0.0 2.0 4.0} {{0.0 0.0} {2.0 -3.0} {4.0 -6.0}} complex 3}

test rbc-readall-2 {vector override inherits handle namespace; snapshots survive handle destruction} -constraints rbc -body {
    set s [newSim]
    begin $s
    set data [::ngspicetclbridge::readVecsAsync -output vector $s]
    $s destroy
    list [dict get $data time] [dict get $data v(1)] \
        [[dict get $data v(out)] range 0 end] [[dict get $data v(1)] range 0 end]
} -cleanup {clean $s} -result {::live::time ::live::v(1) {0.0 2.0 4.0} {{0.0 0.0} {2.0 -3.0} {4.0 -6.0}}}

test rbc-readall-3 {namespace override isolates snapshots from live vectors and list override works} -constraints rbc -body {
    set s [newSim -output vector]
    begin $s
    set data [::ngspicetclbridge::readVecsAsync -namespace ::snap::nested $s]
    set lists [::ngspicetclbridge::readVecsAsync -output list $s]
    set protected [catch {::ngspicetclbridge::readVecsAsync -ifexists replace $s}]
    list [dict get $data time] [dict get [$s vectors] time] [dict get $lists v(out)] $protected
} -cleanup {clean $s} -result {::snap::nested::time ::live::time {0.0 2.0 4.0} 1}

test rbc-readall-4 {relative namespace and simulator command resolve in the helper caller} -constraints rbc -body {
    namespace eval ::snap {
        interp alias {} localSim {} [newSim]
        begin localSim
        set data [::ngspicetclbridge::readVecsAsync -output vector -namespace child::waves localSim]
    }
    dict get $::snap::data time
} -cleanup {clean [interp alias {} ::snap::localSim]} -result ::snap::child::waves::time

test rbc-readall-5 {omitted namespace uses helper caller, not package namespace} -constraints rbc -body {
    set s [::ngspicetclbridge::new $mockLibrary]
    begin $s
    set data [namespace eval ::snap [list ::ngspicetclbridge::readVecsAsync -output vector $s]]
    dict get $data time
} -cleanup {clean $s} -result ::snap::time

test rbc-readall-6 {per-call replacement updates snapshots in place; handle defaults stay unchanged} -constraints rbc -body {
    set s [newSim]
    begin $s
    set data [::ngspicetclbridge::readVecsAsync -output vector -namespace ::snap $s]
    set collision [catch {::ngspicetclbridge::readVecsAsync -output vector -namespace ::snap $s}]
    $s command mock_point
    set again [::ngspicetclbridge::readVecsAsync -output vector -namespace ::snap -ifexists replace $s]
    set default [::ngspicetclbridge::readVecsAsync $s]
    list $collision [expr {$data eq $again}] [::snap::time length] [llength [dict get $default time]]
} -cleanup {clean $s} -result {1 1 4 4}

test rbc-readall-7 {metadata rejects output options without creating namespaces} -body {
    set s [newSim]
    set code [catch {::ngspicetclbridge::readVecsAsync -info -namespace ::snap::unused $s} message]
    list $code $message [namespace exists ::snap::unused]
} -cleanup {clean $s} -result {1 {-info cannot be combined with -output, -namespace, -ifexists or -names} 0}

test rbc-readall-8 {empty namespace and invalid output options are rejected} -constraints rbc -body {
    set s [newSim]
    begin $s
    set empty [catch {::ngspicetclbridge::readVecsAsync -output vector -namespace {} $s} message]
    set invalid [catch {::ngspicetclbridge::readVecsAsync -output wrong $s}]
    set listNamespace [catch {::ngspicetclbridge::readVecsAsync -output list -namespace ::snap::unused $s}]
    list $empty $message $invalid $listNamespace [namespace exists ::snap::unused]
} -cleanup {clean $s} -result {1 {-namespace must not be empty} 1 1 0}

test rbc-readall-9 {direct asyncvector namespace override anchors relative names; absolute names win} -constraints rbc -body {
    set s [newSim]
    begin $s
    set relative [namespace eval ::snap [list $s asyncvector v(out) -output vector -namespace child -name saved]]
    set absolute [$s asyncvector v(1) -output vector -namespace ::snap::child -name ::snap::complex]
    set inherited [$s asyncvector time -output vector]
    list $relative $absolute $inherited [$absolute range 0 end]
} -cleanup {clean $s} -result {::snap::child::saved ::snap::complex ::live::time {{0.0 0.0} {2.0 -3.0} {4.0 -6.0}}}


test rbc-auto-1 {single real and complex snapshots use RBC automatic names and survive handle destruction} -constraints rbc -body {
    set s [newSim]
    begin $s
    set a [$s asyncvector time -output vector -namespace ::snap::automatic -name #auto]
    set b [$s asyncvector v(1) -output vector -namespace ::snap::automatic -name #auto -ifexists replace]
    $s destroy
    list [namespace qualifiers $a] [expr {$a ne $b}] [$a range 0 end] [$b range 0 end] [$b variable]
} -cleanup {clean $s} -result {::snap::automatic 1 {0.0 0.1 0.2} {{0.0 0.0} {2.0 -3.0} {4.0 -6.0}} {}}

test rbc-auto-2 {bulk fresh names preserve keys and repeated reads coexist} -constraints rbc -body {
    set s [newSim]
    begin $s
    set expected [::ngspicetclbridge::readVecsAsync $s]
    set a [::ngspicetclbridge::readVecsAsync -output vector -namespace ::snap -names #auto $s]
    set b [::ngspicetclbridge::readVecsAsync -output vector -namespace ::snap -names #auto $s]
    set ok [expr {[dict keys $expected] eq [dict keys $a]}]
    dict for {key v} $a {
        set ok [expr {$ok && [namespace qualifiers $v] eq "::snap" && $v ne [dict get $b $key]
                     && [$v range 0 end] eq [dict get $expected $key]}]
    }
    set ok
} -cleanup {clean $s} -result 1

test rbc-auto-3 {mixed naming, inherited namespace, and literal auto name} -constraints rbc -body {
    set s [newSim]
    begin $s
    set d [::ngspicetclbridge::readVecsAsync -output vector -names {time #auto v(out) auto} $s]
    list [namespace qualifiers [dict get $d time]] [dict get $d v(out)] [dict get $d v(1)]
} -cleanup {clean $s} -result {::live ::live::auto ::live::v(1)}

test rbc-auto-4 {relative nested namespace override preserves full names} -constraints rbc -body {
    set s [newSim]
    begin $s
    set v [namespace eval ::snap [list $s asyncvector time -output vector -namespace {child::nested} -name #auto]]
    list [namespace qualifiers $v] [$v range 0 end]
} -cleanup {clean $s} -result {::snap::child::nested {0.0 0.1 0.2}}

test rbc-auto-5 {automatic snapshots do not reuse or destroy live bindings} -constraints rbc -body {
    set s [newSim -output vector]
    begin $s
    set live [$s vectors]
    set d [::ngspicetclbridge::readVecsAsync -names #auto $s]
    set same [expr {$live eq [$s vectors]}]
    $s destroy
    list $same [[dict get $d time] length]
} -cleanup {clean $s} -result {1 3}

test rbc-auto-6 {bulk naming rejects invalid options before creating snapshots} -constraints rbc -body {
    set s [newSim]
    begin $s
    set errors {}
    foreach opts {
        {-info -names #auto}
        {-output list -names #auto}
        {-output vector -names {missing #auto}}
        {-output vector -names {time {}}}
        {-output vector -names malformed}
    } {lappend errors [catch {::ngspicetclbridge::readVecsAsync -namespace ::snap {*}$opts $s}]}
    list $errors [info commands ::snap::*]
} -cleanup {clean $s} -result {{1 1 1 1 1} {}}

test rbc-auto-7 {destroy during automatic vector creation removes the new snapshot} -constraints rbc -body {
    set s [newSim]
    begin $s
    set hook [list apply {{sim command code result op} {
        if {[lindex $command 1] eq "create"} {$sim destroy}
    }} $s]
    trace add execution ::rbc::vector leave $hook
    set code [catch {$s asyncvector time -output vector -namespace ::snap -name #auto} message]
    trace remove execution ::rbc::vector leave $hook
    list $code [info commands ::snap::*] $message
} -cleanup {
    catch {trace remove execution ::rbc::vector leave $hook}
    clean $s
} -result {1 {} {simulator handle was destroyed during vector creation}}

foreach rawName {v(out) v(1)} {
    test rbc-readonly-snapshot-$rawName {snapshot replacement rejects locked real/complex output} -constraints rbc -body {
        set s [newSim]
        begin $s
        set v [$s asyncvector $rawName -output vector -name ::snap::copy]
        set before [$v index :]
        $v readonly true
        set code [catch {$s asyncvector $rawName -output vector -name $v -ifexists replace} message options]
        set unchanged [expr {$before eq [$v index :]}]
        $v readonly false
        $s asyncvector $rawName -output vector -name $v -ifexists replace
        list $code [dict get $options -errorcode] $unchanged [$v readonly]
    } -cleanup {clean $s} -result {1 {RBC VECTOR READONLY} 1 0}
}

test rbc-readonly-clear {failed clear preserves every vector and binding; unlocking resumes appends} -constraints rbc -body {
    set s [newSim -output vector]
    begin $s
    ::live::time readonly true
    set mapping [$s vectors]
    set code [catch {$s vectors -clear} message options]
    set lengths [lmap v [dict values $mapping] {$v length}]
    ::live::time readonly false
    $s command mock_point
    update
    set appended [::live::time length]
    $s vectors -clear
    list $code [dict get $options -errorcode] $lengths $appended [::live::time length]
} -cleanup {clean $s} -result {1 {RBC VECTOR READONLY} {3 3 3} 4 0}

foreach rawName {v(out) v(1)} {
    test rbc-readonly-live-$rawName {all live destinations checked before any in-capacity append} -constraints rbc -body {
        set ::outputErrors {}
        set s [newSim -output vector]
        begin $s
        set mapping [$s vectors]
        [dict get $mapping $rawName] readonly true
        $s command mock_point
        update
        set code [catch {$s vectors} message]
        set lengths [lmap v [dict values $mapping] {$v length}]
        [dict get $mapping $rawName] readonly false
        begin $s 2
        set recovered [lmap v [dict values [$s vectors]] {$v length}]
        list $code [string match {*is read-only} $message] [llength $::outputErrors] $lengths $recovered
    } -cleanup {clean $s} -result {1 1 1 {3 3 3} {2 2 2}}
}

test rbc-readonly-adopt {initial replacement refuses a locked vector without creating earlier outputs} -constraints rbc -body {
    rbc::vector create ::live::v(out) -literal true -variable {}
    ::live::v(out) set {99}
    ::live::v(out) readonly true
    set ::outputErrors {}
    set s [newSim -output vector -ifexists replace]
    begin $s
    set code [catch {$s vectors} message]
    list $code [string match {*is read-only} $message] [::live::v(out) index :] [info commands ::live::time]
} -cleanup {clean $s} -result {1 1 99.0 {}}

test rbc-readonly-clear-pending {rejected clear does not discard queued producer samples} -constraints rbc -body {
    set s [newSim -output vector]
    begin $s
    ::live::time readonly true
    $s command mock_point
    set code [catch {$s vectors -clear}]
    ::live::time readonly false
    update
    list $code [lmap v [dict values [$s vectors]] {$v length}]
} -cleanup {clean $s} -result {1 {4 4 4}}

finishTests
