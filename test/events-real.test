# Explicit real-ngspice integration, no Tk or RBC requirement.
if {[lindex $argv 0] ne {--real-events}} {
    return
}
if {[llength $argv] ni {4 5}} {
    error {usage: tclsh events-real.test --real-events bridgeLibrary ngspiceLibrary codeModelDirectory ?stressRuns?}
}
lassign [lrange $argv 1 end] bridgeLibrary ngspiceLibrary codeModelDirectory stressRuns
if {$stressRuns eq {}} {
    set stressRuns 0
}
if {![string is integer -strict $stressRuns] || $stressRuns < 0} {
    error {stressRuns must be a nonnegative integer}
}
if {$ngspiceLibrary eq {}} {
    if {![info exists ::env(NGSPICE_DLL)]} {
        error {set NGSPICE_LIBRARY or NGSPICE_DLL}
    }
    set filename [expr {$::tcl_platform(platform) eq {windows} ? {ngspice.dll} : {libngspice.so}}]
    set ngspiceLibrary [file join $::env(NGSPICE_DLL) $filename]
}
if {![file isfile $ngspiceLibrary]} {
    error "ngspice library not found: $ngspiceLibrary"
}
load [file normalize $bridgeLibrary] Ngspicetclbridge
source [file join [file dirname [info script]] .. ngspicetclbridge.tcl]
package require tcltest
namespace import ::tcltest::*
set argv {}
set fixtureDir [file normalize [file join [file dirname [info script]] events]]

proc realEventSim {circuit} {
    global ngspiceLibrary codeModelDirectory fixtureDir
    # With a supplied directory, load code models explicitly. Otherwise let the installation's spinit load them.
    set options [expr {$codeModelDirectory eq {} ? {} : {-noinit}}]
    set s [::ngspicetclbridge::new {*}$options $ngspiceLibrary]
    try {
        if {$codeModelDirectory ne {}} {
            foreach model {analog digital} {
                set path [file join $codeModelDirectory $model.cm]
                if {![file isfile $path]} {
                    set path [file join $codeModelDirectory $model $model.cm]
                }
                if {![file isfile $path]} {
                    error "code model not found: $path"
                }
                set modelPath [file normalize $path]
                $s command "codemodel $modelPath"
            }
        }
        $s inputpath $fixtureDir
        set f [open [file join $fixtureDir $circuit]]
        try {set netlist [read $f]} finally {close $f}
        if {[$s circuit -string $netlist] != 0} {
            error "circuit rejected: [$s messages]"
        }
        set config [$s eventnodes -all]
        if {![llength [dict get $config selected]]} {
            error "no event nodes; check XSPICE code models: [$s messages]"
        }
        return $s
    } on error {message options} {
        catch {$s destroy}
        return -options $options $message
    }
}
proc completeRun {s {operation bg_run}} {
    set baseline [dict get [$s eventcounts] bg_running]
    if {[$s command $operation] != 0} {
        error "could not start: [$s messages]"
    }
    set waited [$s waitevent bg_running -since $baseline -n 2 30000]
    if {[dict get $waited status] ne {ok}} {
        error "simulation did not finish: $waited; [$s messages]"
    }
    $s command bg_halt
    $s flush
}
proc require {condition message} {
    if {![uplevel 1 [list expr $condition]]} {
        error $message
    }
}
proc histories {data} {
    set result {}
    dict for {name info} [dict get $data nodes] {
        dict set result $name [expr {[dict get $data mode] eq {pernode} ? [dict get $info events] : {}}]
    }
    if {[dict get $data mode] eq {changes}} {
        foreach batch [dict get $data batches] {
            foreach row [dict get $batch events] {
                lassign $row name time value last
                dict lappend result $name [list $time $value $last]
            }
        }
    }
    return $result
}

foreach {circuit nodeCount stopTime numericCount} {
    mixed-invert.cir 6 1e-6 mixed
    digital-source.cir 11 30e-9 pure
} {
    test events-real-$circuit {all modes use raw events; complete snapshots, strings, counters, rerun and ownership}\
            -body {
        set reference {}
        foreach mode {changes snapshot pernode} {
            set s [realEventSim $circuit]
            $s eventnodes -all -mode $mode
            $s eventcounts -clear
            completeRun $s
            set data [$s eventdata]
            set counts [$s eventcounts]
            require {[dict size [dict get $data nodes]] == $nodeCount} {wrong event-node count}
            require {[dict get $counts send_raw_evt] > 0} {no raw events}
            require {[dict get $counts event_init] == 1} {expected one new-plot initialization}
            require {[dict get $counts event_batch] == [dict get $counts send_data]} {final batch missing or duplicated}
            if {$numericCount eq {pure}} {
                require {[dict keys [$s vectors]] eq {time}} {pure digital example unexpectedly contains analog vectors}
            } else {
                require {[dict size [$s vectors]] > 1} {mixed example has no analog vectors}
            }
            if {$mode eq {changes}} {
                set reference [histories $data]
                set rawCount [dict get $counts send_raw_evt]
                set saved $data
                completeRun $s
                require {[histories [$s eventdata]] eq $reference} {rerun duplicates or loses raw events}
                require {[dict get [$s eventcounts] send_raw_evt] == 2*$rawCount} {duplicate raw registration on rerun}
                require {$saved eq $data} {returned snapshot mutated}
            } elseif {$mode eq {snapshot}} {
                set batches [dict get $data batches]
                require {[llength $batches] == [dict get $counts send_data]}\
                        {one snapshot per accepted output point required}
                set final [lindex $batches end]
                require {abs([dict get $final time] - $stopTime) < 1e-15} {incorrect final sample time}
                set previous -1.0
                foreach batch $batches {
                    require {[dict size [dict get $batch values]] == $nodeCount} {incomplete snapshot shape}
                    require {[dict get $batch time] >= $previous} {nonmonotonic sample times}
                    set previous [dict get $batch time]
                }
                dict for {name records} $reference {
                    if {[llength $records]} {
                        require {[dict get $final values $name] eq [lindex $records end 1]}\
                                "incorrect final state: $name actual=[dict get $final values $name]\
                                        expected=[lindex $records end 1] counts=$counts"
                    }
                }
            } else {
                require {[histories $data] eq $reference} {pernode and changes histories differ}
            }
            set cleared [$s eventdata -clear]
            require {[dict get $cleared batches] eq {}} {clear left batches}
            if {$mode eq {pernode}} {
                dict for {name info} [dict get $cleared nodes] {
                    require {[dict get $info events] eq {}} {clear left events}
                }
            }
            $s destroy
            unset s
        }
        set result ok
    } -cleanup {
        if {[info exists s]} {
            catch {$s destroy}
        }
    } -result ok
}

# Breakpoints stop at accepted points, avoiding a race against short simulations.
# Compare node histories with an uninterrupted run and snapshots with native accepted points.
foreach {circuit stopTime} {mixed-invert.cir 1e-6 digital-source.cir 30e-9} {
    foreach mode {changes snapshot pernode} {
        test events-real-resume-$circuit-$mode {two halt/resume cycles match an uninterrupted run} -body {
            set s [realEventSim $circuit]
            $s eventnodes -all -mode $mode
            completeRun $s
            set reference [$s eventdata]
            $s command "stop when time >= [expr {$stopTime * 0.3}]"
            $s eventcounts -clear
            completeRun $s
            set first [$s eventdata]
            require {$first ne $reference} {first halt did not interrupt simulation}
            $s command {delete all}
            $s command "stop when time >= [expr {$stopTime * 0.65}]"
            completeRun $s bg_resume
            set second [$s eventdata]
            set secondTime [lindex [dict get [$s vectors] time] end]
            require {$secondTime >= $stopTime * (0.65 - 1e-12) && $secondTime < $stopTime}\
                    "second halt did not reach its breakpoint: $secondTime target=[expr {$stopTime * 0.65}]"
            if {$mode eq {pernode}} {
                dict for {name info} [dict get $first nodes] {
                    set n [llength [dict get $info events]]
                    require {[lrange [dict get $second nodes $name events] 0 $n-1] eq [dict get $info events]}\
                            {resume changed node prefix}
                }
            } else {
                set n [llength [dict get $first batches]]
                require {[lrange [dict get $second batches] 0 $n-1] eq [dict get $first batches]}\
                        {resume changed batch prefix}
            }
            $s command {delete all}
            completeRun $s bg_resume
            set final [$s eventdata]
            if {$mode eq {snapshot}} {
                # ngspice may change its accepted-point grid after resume.
                require {[lmap b [dict get $final batches] {dict get $b time}] eq [dict get [$s vectors] time]}\
                        {snapshots differ from accepted native points}
                require {[dict get [lindex [dict get $final batches] end] values] eq\
                                 [dict get [lindex [dict get $reference batches] end] values]}\
                        {final states changed after resume}
            } else {
                require {[histories $final] eq [histories $reference]}\
                        {halt/resume lost, duplicated or changed node events}
            }
            require {[dict get [$s eventcounts] event_init] == 1} {resume initialized a new plot}
            require {[dict get [$s eventcounts] event_batch] == [dict get [$s eventcounts] send_data]}\
                    {halt/resume batch count differs from accepted points}
            # Clear at a halted boundary, then resume: the retained prefix must not return.
            $s command "stop when time >= [expr {$stopTime * 0.3}]"
            completeRun $s
            set prefix [$s eventdata]
            set cleared [$s eventdata -clear]
            require {[dict get $cleared batches] eq {}} {clear retained batches}
            $s command {delete all}
            completeRun $s bg_resume
            set suffix [$s eventdata]
            if {$mode eq {pernode}} {
                dict for {name info} [dict get $reference nodes] {
                    set n [llength [dict get $prefix nodes $name events]]
                    require {[dict get $suffix nodes $name events] eq [lrange [dict get $info events] $n end]}\
                            "clear/resume changed history for $name"
                }
            } elseif {$mode eq {changes}} {
                set joined $suffix
                dict set joined batches [concat [dict get $prefix batches] [dict get $suffix batches]]
                require {[histories $joined] eq [histories $reference]} {clear/resume changed node history}
            } else {
                set n [llength [dict get $prefix batches]]
                require {[lmap b [dict get $suffix batches] {dict get $b time}] eq\
                                 [lrange [dict get [$s vectors] time] $n end]}\
                        {cleared snapshots returned or accepted points missing}
                require {[dict get [lindex [dict get $suffix batches] end] values] eq\
                                 [dict get [lindex [dict get $reference batches] end] values]}\
                        {clear lost carried states}
            }
            set result ok
        } -cleanup {
            if {[info exists s]} {
                catch {$s destroy}
                unset s
            }
        } -result ok
    }
}

test events-real-replace {one handle replaces mixed, digital and analog circuits in both input forms} -body {
    set s [realEventSim mixed-invert.cir]
    foreach mode {changes snapshot pernode} {
        $s eventnodes -all -mode $mode
        foreach circuit {digital-source.cir mixed-invert.cir digital-source.cir} form {string list string} {
            set f [open [file join $fixtureDir $circuit]]
            try {
                set deck [read $f]
            } finally {
                close $f
            }
            if {$form eq {string}} {
                require {[$s circuit -string $deck] == 0} {replacement failed}
            } else {
                require {[$s circuit [split [string trim $deck] \n]] == 0} {replacement failed}
            }
            set info [$s eventnodes]
            set expected [expr {$circuit eq {mixed-invert.cir} ? 6 : 11}]
            require {[llength [dict get $info selected]] == $expected} {all did not follow new nodes}
            require {[dict get $info mode] eq $mode} {mode lost}
            require {[dict get [$s eventdata] batches] eq {}} {old batches survived}
            $s eventcounts -clear
            completeRun $s
            require {[dict get [$s eventcounts] send_raw_evt] > 0} {new circuit did not deliver events}
            set data [$s eventdata]
            require {[dict size [dict get $data nodes]] == $expected} {old nodes survived}
        }
        # -all remains selected across a circuit with no digital nodes.
        $s circuit -string "analog only\nv1 in 0 1\nr1 in 0 1k\n.tran 1n 10n\n.end"
        require {[dict get [$s eventnodes] selected] eq {}} {analog circuit retained digital nodes}
        completeRun $s
    }
    set f [open [file join $fixtureDir mixed-invert.cir]]
    try {set deck [read $f]} finally {close $f}
    $s circuit -string $deck
    require {[llength [dict get [$s eventnodes] selected]] == 6} {all lost across analog circuit}
    $s eventnodes -nodes [lrange [dict get [$s eventnodes] available] 0 0]
    $s circuit -string $deck
    require {[dict get [$s eventnodes] selected] eq {}} {explicit selection survived replacement}
    $s eventnodes -all
    completeRun $s
    set result ok
} -cleanup {
    if {[info exists s]} {
        catch {$s destroy}
    }
} -result ok

test events-real-static {OP/DC all modes, subcircuit nodes, nested coordinates, rerun and transient recovery} -body {
    set s [realEventSim op-dc.cir]
    foreach mode {snapshot changes pernode} {
        $s eventnodes -all -mode $mode
        $s command op
        set op [$s eventdata]
        require {[dict get $op analysis] eq {op}} {wrong OP analysis}
        require {[lsort [dict keys [dict get $op nodes]]] eq {xlogic.d xlogic.e}} {subcircuit nodes missing}
        $s command {dc vin 0 2 1}
        set dc [$s eventdata]
        require {[dict get $dc analysis] eq {dc}} {wrong DC analysis}
        if {$mode eq {snapshot}} {
            set states [lmap b [dict get $dc batches] {dict get $b values xlogic.d}]
            require {$states eq {0s Us 1s}} {ADC sweep states incorrect}
        } elseif {$mode eq {changes}} {
            require {[llength [dict get $dc batches]] == 3} {DC changes missing}
        } else {
            set states [lmap row [dict get $dc nodes xlogic.d events] {dict get $row value}]
            require {$states eq {0s Us 1s}} {pernode states incorrect}
        }
        $s command {dc vin 2 0 -1}
        set descending [$s eventdata]
        if {$mode eq {snapshot}} {
            require {[lmap b [dict get $descending batches] {dict get $b values xlogic.d}] eq {1s Us 0s}}\
                    {descending DC states incorrect}
        }
        $s eventdata -clear
        require {[dict get [$s eventdata] batches] eq {}} {clear failed}
        # Keep both ADC inputs below threshold during nested rollover to avoid ngspice's
        # mixed-signal operating-point alternation limit, independent of bridge collection.
        $s command {dc vin 0 0.4 0.2 vbias 0 0.2 0.2}
        set nested [$s eventdata]
        if {$mode eq {snapshot}} {
            set batches [dict get $nested batches]
            require {[llength $batches] == 6} {nested sweep did not finish}
            require {[dict get [lindex $batches end] coordinates] eq {vin 0.4 vbias 0.2}} {outer coordinate lost}
            require {[dict get [lindex $batches end] point] == 5} {wrong point index}
        } elseif {$mode eq {changes}} {
            require {[llength [dict get $nested batches]] == 1} {unchanged DC states not suppressed}
        } else {
            require {[llength [dict get $nested nodes xlogic.d events]] == 1} {unchanged node reports retained}
        }
    }
    # Test deck-based background DC collection, followed by unsupported AC and recovery to tran.
    $s eventnodes -all -mode snapshot
    set f [open [file join $fixtureDir op-dc.cir]]
    try {
        set deck [read $f]
    } finally {
        close $f
    }
    $s circuit -string [string map [list .op {.dc vin 0 0.4 0.2 vbias 0 0.2 0.2}] $deck]
    completeRun $s
    require {[llength [dict get [$s eventdata] batches]] == 6} {deck DC failed}
    $s command {ac lin 2 1 2}
    require {[catch {$s eventdata}]} {AC must not masquerade as a DC snapshot}
    $s circuit -string [string map [list .op {.tran 1n 10n}] $deck]
    completeRun $s
    require {[dict get [$s eventdata] analysis] eq {tran}} {transient did not recover}
    set result ok
} -cleanup {
    if {[info exists s]} {
        catch {$s destroy}
    }
} -result ok

foreach mode {changes snapshot pernode} {
    test events-real-analysis-cycle-$mode {same circuit cycles transient OP DC transient with explicit selection}\
            -body {
        set s [realEventSim op-dc.cir]
        $s eventnodes -nodes xlogic.d -mode $mode
        set reference {}
        $s eventcounts -clear
        for {set cycle 0} {$cycle < 3} {incr cycle} {
            set observed {}
            foreach command {{tran 1n 10n} op {dc vin 0 2 1} {tran 1n 10n}} analysis {tran op dc tran} {
                $s command {alter vin dc = 0}
                require {[$s command $command] == 0} {analysis failed}
                $s flush
                set data [$s eventdata]
                require {[dict get $data analysis] eq $analysis} {previous analysis survived}
                require {[dict keys [dict get $data nodes]] eq {xlogic.d}} {explicit selection changed}
                lappend observed $data
            }
            if {$cycle == 0} {set reference $observed}
            require {$observed eq $reference} "analysis cycle $cycle retained stale history or changed states"
            $s command {destroy all}
            $s messages -clear
            if {$codeModelDirectory ne {}} {$s command -clear}
        }
        require {[dict get [$s eventcounts] event_init] == 12} {wrong number of plot initializations}
        set result ok
    } -cleanup {if {[info exists s]} {catch {$s destroy}; unset s}} -result ok
}

# No RSS pass/fail threshold: native/Tcl allocators may retain freed arenas.
# Exact histories and empty storage are assertions; RSS is a long-run diagnostic.
if {$stressRuns > 0} {
    source [file join [file dirname [info script]] rss-support.tcl]
    foreach circuit {mixed-invert.cir digital-source.cir op-dc.cir} {
        foreach mode {changes snapshot pernode} {
            test events-real-stress-$circuit-$mode {repeated runs and clears keep only the current history} -body {
                set s [realEventSim $circuit]
                $s eventnodes -all -mode $mode
                puts "$circuit/$mode start: RSS=[residentKiB] KiB"
                set f [open [file join $fixtureDir $circuit]]
                try {
                    set deck [read $f]
                } finally {
                    close $f
                }
                # The conservative command cleanup guard rejects d_source and spinit.
                set clearCommands [expr {$codeModelDirectory ne {} && $circuit ne {digital-source.cir}}]
                if {!$clearCommands} {
                    puts "$circuit/$mode: command allocator cleanup unavailable; RSS includes it"
                }
                set reference {}
                for {set i 1} {$i <= $stressRuns} {incr i} {
                    # Synchronous execution exercises the same callbacks without a new worker per run.
                    require {[$s command run] == 0} {run failed}
                    $s flush
                    set data [$s eventdata]
                    if {$circuit eq {op-dc.cir}} {
                        require {[dict get $data analysis] eq {op}} {OP data missing}
                        $s command {dc vin 0 2 1}
                        $s flush
                        set data [$s eventdata]
                        # Restore the source for the next OP run.
                        $s command {alter vin dc = 0}
                    }
                    if {$i == 1} {
                        set reference $data
                    }
                    require {$data eq $reference} "run $i retained stale history or changed states"
                    set empty [$s eventdata -clear]
                    require {[dict get $empty batches] eq {}} {batches survived clear}
                    if {$mode eq {pernode}} {
                        dict for {name info} [dict get $empty nodes] {
                            require {[dict get $info events] eq {}} {node history survived clear}
                        }
                    }
                    # Clear other owners too, so RSS is not simply retained plots/messages/numeric samples.
                    $s vectors -clear
                    $s command {destroy all}
                    $s messages -clear
                    if {$clearCommands} {
                        $s command -clear
                    }
                    # Native event jobs outlive numeric plots. Release them in bounded
                    # groups, exercising same-handle circuit replacement and registration.
                    if {$i % 25 == 0 || $i == $stressRuns} {
                        require {[$s circuit -string $deck] == 0} {stress replacement failed}
                        set replaced [$s eventdata]
                        require {[dict get $replaced batches] eq {}} {replacement retained batches}
                        require {[dict get [$s eventnodes] mode] eq $mode} {replacement lost mode}
                        if {$mode eq {pernode}} {
                            dict for {name info} [dict get $replaced nodes] {
                                require {[dict get $info events] eq {}} {replacement retained node history}
                            }
                        }
                    }
                    if {$i == 25 || $i % 100 == 0 || $i == $stressRuns} {
                        puts "$circuit/$mode run $i: RSS=[residentKiB] KiB"
                    }
                }
                set result ok
            } -cleanup {
                if {[info exists s]} {
                    catch {$s destroy}
                    unset s
                }
            } -result ok
        }
    }
}

set failed $::tcltest::numTests(Failed)
cleanupTests
exit [expr {$failed != 0}]
